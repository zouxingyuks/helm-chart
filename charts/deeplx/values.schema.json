{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "DeepLX Helm Chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "serviceAccount", "podSecurityContext", "containerSecurityContext", "service", "ingress", "auth", "readinessProbe", "livenessProbe", "autoscaling", "podDisruptionBudget", "updateStrategy", "test"],
  "properties": {
    "global": {"type": "object", "additionalProperties": true},
    "common": {"type": "object", "additionalProperties": true},
    "nameOverride": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "fullnameOverride": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "namespaceOverride": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "commonLabels": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "commonAnnotations": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"$ref": "#/definitions/image"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
        "annotations": {"type": "object", "additionalProperties": true},
        "automountServiceAccountToken": {"type": "boolean"}
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": true},
    "podLabels": {"type": "object", "additionalProperties": true},
    "podSecurityContext": {"$ref": "#/definitions/extensibleContext"},
    "containerSecurityContext": {"$ref": "#/definitions/extensibleContext"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": true}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "hosts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostname"],
            "properties": {
              "hostname": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(\\.([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$"},
              "annotations": {"type": "object", "additionalProperties": true},
              "path": {"type": "string"},
              "pathType": {"type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"]},
              "tls": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "token", "dlSession", "proxy"],
      "properties": {
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "keyMapping"],
          "properties": {
            "name": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,251}[a-z0-9])?$"},
            "keyMapping": {
              "type": "object",
              "additionalProperties": false,
              "required": ["token", "dlSession", "proxy"],
              "properties": {
                "token": {"type": "string", "minLength": 1},
                "dlSession": {"type": "string", "minLength": 1},
                "proxy": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "token": {"type": "string"},
        "dlSession": {"type": "string"},
        "proxy": {"type": "string"}
      }
    },
    "extraEnvVars": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "extraEnvVarsCM": {"type": "string"},
    "extraEnvVarsSecret": {"type": "string"},
    "readinessProbe": {"$ref": "#/definitions/probe"},
    "livenessProbe": {"$ref": "#/definitions/probe"},
    "customReadinessProbe": {"$ref": "#/definitions/customProbe"},
    "customLivenessProbe": {"$ref": "#/definitions/customProbe"},
    "resources": {"type": "object", "additionalProperties": true},
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1, "maximum": 100},
        "targetMemoryUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1, "maximum": 100}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"$ref": "#/definitions/intOrPercentOrNull"},
        "maxUnavailable": {"$ref": "#/definitions/intOrPercentOrNull"}
      }
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["RollingUpdate", "Recreate"]},
        "rollingUpdate": {"type": "object", "additionalProperties": true}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "nodeSelector": {"type": "object", "additionalProperties": true},
    "tolerations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "podAffinityPreset": {"type": "string", "enum": ["", "soft", "hard"]},
    "podAntiAffinityPreset": {"type": "string", "enum": ["", "soft", "hard"]},
    "nodeAffinityPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "values"],
      "properties": {
        "type": {"type": "string", "enum": ["", "soft", "hard"]},
        "key": {"type": "string"},
        "values": {"type": "array", "items": {"type": "string"}}
      }
    },
    "affinity": {"type": "object", "additionalProperties": true},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "priorityClassName": {"type": "string"},
    "schedulerName": {"type": "string"},
    "extraVolumes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "extraVolumeMounts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {"image": {"$ref": "#/definitions/image"}}
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "repository", "tag", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "extensibleContext": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}},
      "additionalProperties": true
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"],
      "properties": {
        "enabled": {"type": "boolean"},
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "successThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "customProbe": {
      "type": "object",
      "additionalProperties": true,
      "oneOf": [
        {"maxProperties": 0},
        {"required": ["exec"]},
        {"required": ["httpGet"]},
        {"required": ["tcpSocket"]}
      ]
    },
    "intOrPercentOrNull": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "pattern": "^(100|[1-9]?[0-9])%$"},
        {"type": "null"}
      ]
    }
  }
}
