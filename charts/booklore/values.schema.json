{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of replicas"
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Image repository"
        },
        "tag": {
          "type": "string",
          "description": "Image tag (defaults to appVersion if not set)"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy"
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override release name"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override full release name"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a ServiceAccount"
        },
        "name": {
          "type": "string",
          "description": "ServiceAccount name"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "description": "Pod annotations"
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "fsGroup": {
          "type": "integer",
          "minimum": 0,
          "description": "File system group ID"
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean",
          "description": "Prevent privilege escalation"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"],
          "description": "Kubernetes Service type"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port"
        }
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Container port"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Ingress"
        },
        "className": {
          "type": "string",
          "description": "Ingress class name"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "description": "Ingress hostname"
        },
        "path": {
          "type": "string",
          "description": "Ingress path"
        },
        "pathType": {
          "type": "string",
          "enum": ["Prefix", "Exact", "ImplementationSpecific"],
          "description": "Ingress path type"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU limit (e.g., 1000m)"
            },
            "memory": {
              "type": "string",
              "description": "Memory limit (e.g., 1Gi)"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU request (e.g., 500m)"
            },
            "memory": {
              "type": "string",
              "description": "Memory request (e.g., 512Mi)"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable autoscaling"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum replicas"
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum replicas"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Target CPU utilization percentage"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable PodDisruptionBudget"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum available pods"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable data persistence"
            },
            "size": {
              "type": "string",
              "description": "Data storage size (e.g., 10Gi)"
            },
            "storageClass": {
              "type": "string",
              "description": "Storage class name"
            }
          }
        },
        "books": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable books persistence"
            },
            "size": {
              "type": "string",
              "description": "Books storage size (e.g., 20Gi)"
            },
            "storageClass": {
              "type": "string",
              "description": "Storage class name"
            }
          }
        },
        "bookdrop": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable bookdrop persistence"
            },
            "size": {
              "type": "string",
              "description": "Bookdrop storage size (e.g., 5Gi)"
            },
            "storageClass": {
              "type": "string",
              "description": "Storage class name"
            }
          }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable MariaDB"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "MariaDB port"
        },
        "auth": {
          "type": "object",
          "properties": {
            "rootPassword": {
              "type": "string",
              "description": "MariaDB root password (required when MariaDB is enabled)"
            },
            "database": {
              "type": "string",
              "description": "Database name"
            },
            "username": {
              "type": "string",
              "description": "Database user"
            },
            "password": {
              "type": "string",
              "description": "Database password (required when MariaDB is enabled)"
            }
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "External database host"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "External database port"
        },
        "user": {
          "type": "string",
          "description": "External database user"
        },
        "password": {
          "type": "string",
          "description": "External database password"
        },
        "database": {
          "type": "string",
          "description": "External database name"
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Environment variables"
    },
    "extraEnv": {
      "type": "array",
      "description": "Extra environment variables"
    },
    "extraEnvFrom": {
      "type": "array",
      "description": "Extra environment variables from ConfigMap/Secret"
    },
    "healthCheck": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable health check"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Health check path"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Initial delay seconds"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Period seconds"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Timeout seconds"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 0,
          "description": "Failure threshold"
        }
      }
    }
  }
}
